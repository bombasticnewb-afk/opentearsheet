# Copy to .env and edit:  cp .env.example .env
# .env is git-ignored. Never commit it.

# REQUIRED by the SEC for free API access: your name and a real contact email.
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="Your Name you@yourdomain.com"

# Local cache location (default: ~/.opentearsheet)
# OPENTEARSHEET_DATA_DIR=~/.opentearsheet

# Requests per second to SEC servers. The SEC allows at most 10; default 5.
# SEC_MAX_RPS=5

# Hours before cached indexes/search results refresh. Filing documents never change and never expire.
# CACHE_TTL_HOURS=6

# Narrative engine: none (deterministic cited template) | ollama | openai_compatible
LLM_PROVIDER=none

# Ollama, running locally: https://ollama.com  (then: ollama pull llama3.1:8b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Any OpenAI-compatible server. Defaults to LM Studio on localhost; llama.cpp / vLLM work too.
OPENAI_COMPAT_BASE_URL=http://localhost:1234/v1
OPENAI_COMPAT_MODEL=local-model
OPENAI_COMPAT_API_KEY=

# Safety switch: LLM endpoints that are not on this machine are refused unless this is true.
ALLOW_REMOTE_LLM=false
# LLM_TIMEOUT_SECONDS=180

# Start the app in offline demo mode (synthetic data)
# OPENTEARSHEET_DEMO=false
